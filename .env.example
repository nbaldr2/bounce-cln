# Database
DATABASE_URL="postgresql://bounce:bounce_secret@localhost:5432/bounce_cln?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# API
API_PORT=4000
API_HOST=0.0.0.0

# HMAC Secret for Agent Authentication
HMAC_SECRET="change-this-to-a-strong-random-string"

# SSH Default Credentials (for node provisioning)
SSH_DEFAULT_PORT=22
SSH_DEFAULT_USER=root

# Dashboard
NEXT_PUBLIC_API_URL=http://localhost:4000

# Node Agent
MASTER_API_URL=http://your-master-ip:4000
NODE_HMAC_SECRET="change-this-to-a-strong-random-string"
HEARTBEAT_INTERVAL=30
